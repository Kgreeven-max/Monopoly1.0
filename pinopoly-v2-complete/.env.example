# ===================================
# Pinopoly V2 Environment Variables
# ===================================

# Copy this file to .env and update the values for your environment

# ===================================
# Application Configuration
# ===================================
APP_NAME=Pinopoly V2
APP_VERSION=2.0.0
ENVIRONMENT=development  # development, staging, production
DEBUG=true

# ===================================
# Backend Configuration
# ===================================

# Database Configuration
DATABASE_URL=postgresql://pinopoly_user:pinopoly_pass@localhost:5432/pinopoly_dev
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=pinopoly_dev
DATABASE_USER=pinopoly_user
DATABASE_PASSWORD=pinopoly_pass
DATABASE_SSL_MODE=prefer

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security Keys (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=dev-secret-key-change-in-production-use-256-bit-key
JWT_SECRET=dev-jwt-secret-change-in-production-use-strong-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API Configuration
API_VERSION=v1
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_REQUEST_SIZE=10MB

# WebSocket Configuration
WEBSOCKET_PATH=/ws
WEBSOCKET_CORS_ORIGINS=*
WEBSOCKET_PING_TIMEOUT=60
WEBSOCKET_PING_INTERVAL=25

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=10

# ===================================
# Frontend Configuration
# ===================================

# API Endpoints
VITE_API_URL=http://localhost:8000
VITE_API_VERSION=v1
VITE_WS_URL=ws://localhost:8000

# Application Settings
VITE_APP_NAME=Pinopoly V2
VITE_APP_VERSION=2.0.0
VITE_ENV=development

# Feature Flags
VITE_ENABLE_DEV_TOOLS=true
VITE_ENABLE_ANIMATIONS=true
VITE_ENABLE_SOUND_EFFECTS=true
VITE_ENABLE_MULTIPLAYER=true

# ===================================
# Game Configuration
# ===================================

# Game Rules
MAX_PLAYERS_PER_GAME=8
MIN_PLAYERS_PER_GAME=2
DEFAULT_STARTING_MONEY=1500
PASS_GO_BONUS=200
LUXURY_TAX_AMOUNT=100
INCOME_TAX_AMOUNT=200

# Bot Configuration
ENABLE_AI_BOTS=true
DEFAULT_BOT_DIFFICULTY=medium
MAX_BOTS_PER_GAME=6
BOT_THINKING_TIME_MS=2000

# Economic System
ENABLE_ECONOMIC_CYCLES=true
ECONOMIC_CYCLE_INTERVAL_MINUTES=5
ENABLE_RANDOM_EVENTS=true
PROPERTY_VALUE_FLUCTUATION_PERCENT=10

# ===================================
# Logging Configuration
# ===================================

# Log Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FORMAT=json  # json or plain
LOG_TO_FILE=true
LOG_FILE_PATH=logs/pinopoly.log
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=5

# Specific Logger Levels
DATABASE_LOG_LEVEL=WARNING
WEBSOCKET_LOG_LEVEL=INFO
API_LOG_LEVEL=INFO

# ===================================
# Monitoring & Observability
# ===================================

# Metrics
ENABLE_METRICS=true
METRICS_PORT=9000
METRICS_PATH=/metrics

# Health Checks
HEALTH_CHECK_INTERVAL_SECONDS=30
HEALTH_CHECK_TIMEOUT_SECONDS=10

# Distributed Tracing
ENABLE_TRACING=false
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# ===================================
# Email Configuration (Optional)
# ===================================

# SMTP Settings
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@pinopoly.com
SMTP_FROM_NAME=Pinopoly V2

# ===================================
# External Services (Optional)
# ===================================

# Cloud Storage (for file uploads)
CLOUD_STORAGE_PROVIDER=local  # local, aws-s3, gcp-storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=
MIXPANEL_TOKEN=

# Error Tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ===================================
# Development Tools
# ===================================

# Database Tools
ENABLE_DB_ADMIN=true
PGADMIN_EMAIL=admin@pinopoly.com
PGADMIN_PASSWORD=admin

# Redis Tools
ENABLE_REDIS_COMMANDER=true

# API Documentation
ENABLE_SWAGGER_UI=true
SWAGGER_UI_PATH=/docs

# ===================================
# Testing Configuration
# ===================================

# Test Database
TEST_DATABASE_URL=postgresql://pinopoly_user:pinopoly_pass@localhost:5432/pinopoly_test
TEST_REDIS_URL=redis://localhost:6379/1

# Test Settings
PYTEST_PARALLEL_WORKERS=auto
COVERAGE_THRESHOLD=90

# ===================================
# Security Configuration
# ===================================

# Session Configuration
SESSION_TIMEOUT_MINUTES=30
REMEMBER_ME_DURATION_DAYS=30

# Password Requirements
MIN_PASSWORD_LENGTH=8
REQUIRE_UPPERCASE=true
REQUIRE_LOWERCASE=true
REQUIRE_NUMBERS=true
REQUIRE_SPECIAL_CHARS=true

# Account Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
ENABLE_TWO_FACTOR_AUTH=false

# Content Security
ENABLE_CONTENT_SECURITY_POLICY=true
ALLOWED_HOSTS=localhost,127.0.0.1,*.pinopoly.com

# ===================================
# Performance Configuration
# ===================================

# Database Connection Pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Redis Connection Pool
REDIS_POOL_SIZE=20
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# Caching
ENABLE_RESPONSE_CACHING=true
CACHE_DEFAULT_TIMEOUT=300
CACHE_LONG_TIMEOUT=3600

# ===================================
# Deployment Configuration
# ===================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=1  # For development, increase for production

# SSL Configuration (Production)
SSL_ENABLED=false
SSL_CERT_PATH=
SSL_KEY_PATH=

# Load Balancer Configuration
BEHIND_LOAD_BALANCER=false
PROXY_COUNT=1

# ===================================
# Backup Configuration
# ===================================

# Database Backups
ENABLE_AUTO_BACKUP=false
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=backups/

# ===================================
# Feature Flags
# ===================================

# Game Features
ENABLE_PROPERTY_AUCTIONS=true
ENABLE_PLAYER_TRADING=true
ENABLE_LOANS_AND_MORTGAGES=true
ENABLE_SPECIAL_CARDS=true
ENABLE_JAIL_SYSTEM=true

# Social Features
ENABLE_CHAT=true
ENABLE_PLAYER_ALLIANCES=false
ENABLE_TOURNAMENTS=false

# Admin Features
ENABLE_ADMIN_PANEL=true
ENABLE_GAME_SPECTATING=true
ENABLE_REPLAY_SYSTEM=false

# Experimental Features
ENABLE_VOICE_CHAT=false
ENABLE_VIDEO_CALLS=false
ENABLE_CUSTOM_BOARDS=false