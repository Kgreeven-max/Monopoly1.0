# ===========================================
# Pinopoly v2 Environment Configuration
# ===========================================

# Server Configuration
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://pinopoly:pinopoly_dev@localhost:5432/pinopoly_master

# Redis (for bot workers)
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
ADMIN_TOKEN=admin-secret-token-change-in-production

# Game Configuration
MAX_CONCURRENT_GAMES=10
MAX_PLAYERS_PER_GAME=8
BOT_THINK_DELAY_MS=1500

# Feature Flags
ENABLE_ECONOMIC_CYCLES=true
ENABLE_FINANCIAL_INSTRUMENTS=true
ENABLE_CRIME_SYSTEM=false

# Logging
LOG_LEVEL=debug

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003
