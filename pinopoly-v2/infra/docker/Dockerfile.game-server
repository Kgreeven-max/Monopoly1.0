# Game Server Dockerfile
# Multi-stage build for optimized production image

# =============================================================================
# Stage 1: Dependencies
# =============================================================================
FROM node:20-alpine AS deps

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

# Copy package files
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/game-engine/package.json ./packages/game-engine/
COPY services/game-server/package.json ./services/game-server/

# Install dependencies
RUN pnpm install

# =============================================================================
# Stage 2: Builder
# =============================================================================
FROM node:20-alpine AS builder

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

# Copy dependencies
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=deps /app/packages/game-engine/node_modules ./packages/game-engine/node_modules
COPY --from=deps /app/services/game-server/node_modules ./services/game-server/node_modules

# Copy source
COPY . .

# Generate Prisma client (in builder where devDeps are available)
RUN pnpm --filter game-server exec prisma generate

# Build packages in order
RUN pnpm --filter @pinopoly/shared build
RUN pnpm --filter @pinopoly/game-engine build
RUN pnpm --filter game-server build

# =============================================================================
# Stage 3: Production
# =============================================================================
FROM node:20-slim AS production

# Install openssl for Prisma
RUN apt-get update && apt-get install -y openssl ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install pnpm (for running)
RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

# Create non-root user
RUN groupadd --gid 1001 nodejs && \
    useradd --uid 1001 --gid nodejs --shell /bin/bash --create-home pinopoly

# Copy built artifacts
COPY --from=builder --chown=pinopoly:nodejs /app/package.json ./
COPY --from=builder --chown=pinopoly:nodejs /app/pnpm-workspace.yaml ./
COPY --from=builder --chown=pinopoly:nodejs /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder --chown=pinopoly:nodejs /app/packages/shared/package.json ./packages/shared/
COPY --from=builder --chown=pinopoly:nodejs /app/packages/game-engine/dist ./packages/game-engine/dist
COPY --from=builder --chown=pinopoly:nodejs /app/packages/game-engine/package.json ./packages/game-engine/
COPY --from=builder --chown=pinopoly:nodejs /app/services/game-server/dist ./services/game-server/dist
COPY --from=builder --chown=pinopoly:nodejs /app/services/game-server/package.json ./services/game-server/
COPY --from=builder --chown=pinopoly:nodejs /app/services/game-server/prisma ./services/game-server/prisma

# Install production dependencies only
RUN pnpm install --prod

# Generate Prisma client (use npx with specific version to match package.json)
RUN cd services/game-server && npx prisma@5.22.0 generate

USER pinopoly

EXPOSE 3000

ENV NODE_ENV=production
ENV PORT=3000

CMD ["node", "services/game-server/dist/index.js"]
